// Signed varints, which write a signed integer in as few bytes as its
// magnitude needs.
//
// A signed varint is two transforms applied in order.  The ZigZag fold
// renumbers the integers 0, -1, 1, -2, 2, ... onto 0, 1, 2, 3, 4, ..., so
// that magnitude rather than sign decides the size.  Base 128 groups,
// which DWARF section 7.6 calls LEB128, then write the folded number
// seven bits to a byte.  Without the fold, two's complement makes every
// negative number large, and -1 takes ten bytes.  Protocol Buffers calls
// the pairing `sint32` and `sint64`.
//
// The module encodes and decodes at 64 bits and at 32.  Each width has a
// form that writes into a cursor the caller owns, a form that allocates
// its own buffer, and `decode_at` for a caller walking a buffer by
// offset.  `encoded_len` answers how many bytes a value will take, and
// `max_len` how many any value can take.
//
// A malformed input is a value and never a panic.  `VarintError` says
// that the input ran out, that the number does not fit 64 bits, or that
// the number is outside the signed 32-bit range the 32-bit pair is
// defined over.
//
// The fold is two shifts and an xor with no branch.  The byte loop is
// one shift, one mask and one write per output byte.  Neither allocates,
// and the arithmetic is `Int` throughout, so nothing here needs a heap.
//
// The 64-bit pair covers the whole signed range and takes up to ten
// bytes.  The 32-bit pair is defined over the signed 32-bit range and
// takes up to five.  `fits32` is the check a caller makes where the
// number arrives.

use std.bytes
use leb128
use zigzag

// ── How much room a value needs ──────────────────────────────────────

// Answer the most bytes a 64-bit value can occupy, which is ten.
//
// The fold is a bijection onto the unsigned 64-bit range, so this is
// LEB128's own bound and not a looser one.  It is the room to reserve
// for a value not yet computed.  `encoded_len` is the exact answer for a
// value in hand.
//
// ```novo
// println("${varint.max_len()}")   // 10
// ```
pub fn max_len() -> Int
    leb128.max_len()

// Answer the most bytes a 32-bit value can occupy, which is five.
//
// The fold of a value inside the signed 32-bit range stays inside 32
// bits, and five 7-bit groups carry 35 of them.
//
// ```novo
// println("${varint.max_len32()}")   // 5
// ```
pub fn max_len32() -> Int
    5

// Answer how many bytes `value` will occupy at 64 bits, without
// encoding it.
//
// Magnitude decides the length, and sign does not.  `-1` and `1` are the
// same length, because the fold puts them next to each other.  Nothing
// is refused and nothing is allocated.
//
// ```novo
// // Each negative here is as short as its positive.  A plain LEB128
// // spends ten bytes on each of them.
// println("${varint.encoded_len(0 - 1)} ${varint.encoded_len(1)}")         // 1 1
// println("${varint.encoded_len(0 - 1000)} ${varint.encoded_len(1000)}")   // 2 2
//
// // No value exceeds the reservation.
// println("${varint.encoded_len(1 << 62)} ${varint.max_len()}")      // 10 10
// ```
pub fn encoded_len(value: Int) -> Int
    leb128.encoded_len(zigzag.encode64(value))

// Answer how many bytes `value` will occupy at 32 bits, without
// encoding it.
//
// The answer is defined over the signed 32-bit range.  Outside it the
// fold means something else, so ask `fits32` first.  The answer is
// never more than `max_len32()`.
//
// ```novo
// println("${varint.encoded_len32(0 - 1)}")                              // 1
// println("${varint.encoded_len32(varint.min32())} ${varint.max_len32()}")   // 5 5
// ```
pub fn encoded_len32(value: Int) -> Int
    leb128.encoded_len(zigzag.encode32(value))

// ── The range the 32-bit pair is defined over ────────────────────────

// Answer the lowest value the 32-bit pair encodes exactly, `-2^31`.
//
// It is the bottom of Protocol Buffers' `sint32` range.  `fits32` asks
// about both ends at once.
//
// ```novo
// println("${varint.min32()}")   // -2147483648
// ```
pub fn min32() -> Int
    zigzag.min32()

// Answer the highest value the 32-bit pair encodes exactly, `2^31 - 1`.
//
// It is the top of Protocol Buffers' `sint32` range.
//
// ```novo
// println("${varint.max32()}")   // 2147483647
// ```
pub fn max32() -> Int
    zigzag.max32()

// Answer whether `n` is inside the range the 32-bit pair is defined
// over.
//
// This is the check a caller makes once, where the number arrives.
// `encode32` does not check.  A value outside the range folds to a
// well-formed number that means something else to every other
// implementation, and nothing downstream notices.  The 64-bit pair needs
// no such check, because every `Int` is in its range.
//
// ```novo
// println("${varint.fits32(varint.max32())}")       // true
// println("${varint.fits32(varint.max32() + 1)}")   // false
// println("${varint.fits32(varint.min32() - 1)}")   // false
// ```
pub fn fits32(n: Int) -> Bool
    zigzag.fits32(n)

// ── What can go wrong on the way in ──────────────────────────────────

// What went wrong while reading, and after how many bytes.
//
// All three variants are faults in the input rather than mistakes in
// the program, so all three are values.  `Truncated` and `Overflow` come
// from the byte loop and can happen at either width.  `NotInt32` is
// about the reader's width rather than the bytes, so a caller that gets
// it can read the same bytes again at 64 bits and succeed.  `decode` and
// `decode32` carry the examples.
pub enum VarintError
    // The input ended while a continuation bit was still set.
    Truncated(after: Int)
    // The groups read so far already exceed 64 bits.
    Overflow(after: Int)
    // The number is well formed but outside the signed 32-bit range,
    // so a 32-bit reader cannot answer with it.
    NotInt32(after: Int)

// The standard `Error` implementation, so a bad varint can be reported
// by anything that reports errors.
impl Error for VarintError
    // Answer the one-line report of what was wrong and after how many
    // bytes of input.  The count is in the text, so a caller that prints
    // the error does not need the count to hand.
    //
    // ```novo
    // println(VarintError.Truncated(after: 1).message())
    // // varint: input ended after 1 byte(s) with the varint unfinished
    // ```
    fn message(self) -> Str
        match self
            Truncated(after) => "varint: input ended after ${after} byte(s) with the varint unfinished"
            Overflow(after)  => "varint: the varint exceeds 64 bits after ${after} byte(s)"
            NotInt32(after)  => "varint: the varint after ${after} byte(s) is outside the signed 32-bit range"

// A `Leb128Error` as this module's error.  The byte loop is LEB128's, so
// its two faults are two of this module's faults.  The third is about
// the 32-bit range, and only the 32-bit readers raise it.
fn lifted(e: Leb128Error) -> VarintError
    match e
        Truncated(after) => VarintError.Truncated(after: after)
        Overflow(after)  => VarintError.Overflow(after: after)

// ── 64 bits ──────────────────────────────────────────────────────────

// Write `value` at the cursor in as many bytes as it needs, and answer
// that count.
//
// The call writes into the caller's buffer and allocates nothing.  The
// cursor must have `encoded_len(value)` bytes of room, and reserving
// `max_len()` always suffices.  Too little room is a panic, as it is
// for `c.put_u8` and for `xs[i]`, because a buffer the caller sized
// wrong is a mistake in the program rather than input.
//
// The position lives in a cursor rather than in an offset parameter.  A
// `Bytes` passed as a parameter is borrowed, so a write through it would
// land in a copy the caller never sees.  A cursor owns its buffer, so a
// write through one lands where the caller reads it.  The standard
// library's own writers follow the same rule.
//
// ```novo
// use std.bytes
//
// // Two signed fields into one frame, back to back.
// var out = bytes.cursor_le(bytes.zeros(2 * varint.max_len()))
// let n = varint.encode_into(out, 0 - 1) + varint.encode_into(out, 300)
// println("${n}")                                         // 3
// println(bytes.to_hex(bytes.slice(out.finish(), 0, n)))  // 01d804
// ```
pub fn encode_into(var dst: Cursor, value: Int) -> Int
    leb128.encode_into(dst, zigzag.encode64(value))

// Encode `value` into a fresh buffer of exactly its own length.
//
// The call makes one allocation, for the result.  It is the form for a
// caller building a message rather than filling a frame.  `decode`
// inverts it exactly over the whole signed 64-bit range.
//
// ```novo
// use std.bytes
//
// // -1 is one byte here, and ten in a plain LEB128.
// println(bytes.to_hex(varint.encode(0 - 1)))    // 01
// println(bytes.to_hex(varint.encode(0 - 75)))   // 9501
//
// // Decoding what was encoded answers the original value.
// match varint.decode(varint.encode(0 - 75))
//     Ok(v)  => println("${v}")                  // -75
//     Err(e) => println(e.message())
// ```
pub fn encode(value: Int) -> Bytes
    leb128.encode(zigzag.encode64(value))

// Read the varint at the cursor, and leave the cursor on the byte after
// it.
//
// The call reads the caller's buffer and allocates nothing.  The
// cursor's position after a successful read is where the next number
// starts, so a caller decoding a run of varints calls again with the
// same cursor.
//
// ```novo
// use std.bytes
//
// // The two fields `encode_into`'s example wrote: -1, then 300.
// var r = bytes.cursor_le(bytes.from_hex("01d804") ?? bytes.zeros(0))
// match varint.decode_from(r)
//     Ok(v)  => println("${v} ends at ${r.pos()}")   // -1 ends at 1
//     Err(e) => println(e.message())
// match varint.decode_from(r)
//     Ok(v)  => println("${v} ends at ${r.pos()}")   // 300 ends at 3
//     Err(e) => println(e.message())
// ```
pub fn decode_from(var src: Cursor) -> Result<Int, VarintError>
    match leb128.decode_from(src)
        Ok(folded) => Ok(zigzag.decode64(folded))
        Err(e)     => Err(lifted(e))

// Read the varint at the start of `src`, ignoring whatever follows it.
//
// The call reads the bytes where they are and keeps no position, so a
// caller reading a run of varints holds one cursor and calls
// `decode_from` instead.  A malformed
// input answers an `Err` carrying the byte count reached, and never
// panics.
//
// ```novo
// use std.bytes
//
// match varint.decode(bytes.from_hex("9501") ?? bytes.zeros(0))
//     Ok(v)  => println("${v}")          // -75
//     Err(e) => println(e.message())
//
// // A continuation bit with nothing after it answers an error.
// match varint.decode(bytes.from_hex("95") ?? bytes.zeros(0))
//     Ok(v)  => println("${v}")
//     Err(e) => println(e.message())     // varint: input ended after 1 byte(s) …
// ```
pub fn decode(src: Bytes) -> Result<Int, VarintError>
    match read_folded_at(src, 0)
        Err(e) => Err(e)
        Ok(d)  => Ok(zigzag.decode64(d.value))

// A varint and the number of bytes it occupied.
//
// The two travel together because a reader that has the value and not
// the length cannot find the next field.  `decode_at` and `decode32_at`
// answer one.  `decode_at` carries the example.
pub struct Decoded
    value: Int
    len: Int

// Read the varint at `off` in `src`, and answer it with the length it
// took.
//
// This is the call for a caller walking a buffer by offset rather than
// by cursor, such as a table of varint-encoded entries or a format that
// gives each record's start.  The next offset is `off + d.len`.
//
// An offset outside the buffer answers `Truncated(after: 0)` rather
// than a panic.  An offset read out of the data being decoded is input,
// and input never stops the program.
//
// ```novo
// use std.bytes
//
// // -1 then 300.  The second starts where the first one ended.
// let buf = bytes.from_hex("01d804") ?? bytes.zeros(0)
// match varint.decode_at(buf, 0)
//     Ok(d)  => println("${d.value} in ${d.len} byte(s)")   // -1 in 1 byte(s)
//     Err(e) => println(e.message())
// match varint.decode_at(buf, 1)
//     Ok(d)  => println("${d.value} in ${d.len} byte(s)")   // 300 in 2 byte(s)
//     Err(e) => println(e.message())
// ```
pub fn decode_at(src: Bytes, off: Int) -> Result<Decoded, VarintError>
    match read_folded_at(src, off)
        Err(e) => Err(e)
        Ok(d)  => Ok(Decoded { value: zigzag.decode64(d.value), len: d.len })

// ── 32 bits ──────────────────────────────────────────────────────────

// Write `value` at the cursor folded onto 32 bits, and answer the byte
// count.
//
// The call is defined over `fits32`.  A value outside that range folds
// to a different number than every other implementation produces, so
// the check belongs where the number arrives rather than here.
// Reserving `max_len32()` always suffices.
//
// ```novo
// use std.bytes
//
// var out = bytes.cursor_le(bytes.zeros(varint.max_len32()))
// let n = varint.encode32_into(out, 0 - 75)
// println("${n}")                                         // 2
// println(bytes.to_hex(bytes.slice(out.finish(), 0, n)))  // 9501
// ```
pub fn encode32_into(var dst: Cursor, value: Int) -> Int
    leb128.encode_into(dst, zigzag.encode32(value))

// Encode `value` folded onto 32 bits, as a fresh buffer of its own
// length.
//
// It writes the same bytes as the 64-bit form wherever both are
// defined, because the fold is one renumbering and the 32-bit half has
// less room above it.  What differs is the ceiling, five bytes rather
// than ten.
//
// ```novo
// use std.bytes
//
// // Inside the 32-bit range the two widths agree byte for byte.
// println(bytes.to_hex(varint.encode32(0 - 75)))   // 9501
//
// match varint.decode32(varint.encode32(varint.min32()))
//     Ok(v)  => println("${v}")                    // -2147483648
//     Err(e) => println(e.message())
// ```
pub fn encode32(value: Int) -> Bytes
    leb128.encode(zigzag.encode32(value))

// Read the 32-bit varint at the cursor, and leave the cursor after it.
//
// A well-formed number outside the signed 32-bit range answers
// `NotInt32`.  The bytes are a valid varint, so the fault is the
// reader's width rather than the encoding, and a caller can read the
// same bytes again at 64 bits.  The cursor is left after the number
// either way.  A caller that reads again at 64 bits moves the cursor
// back to where the number started.
//
// ```novo
// use std.bytes
//
// // -75 then 300, read one after the other with one cursor.
// var r = bytes.cursor_le(bytes.from_hex("9501d804") ?? bytes.zeros(0))
// match varint.decode32_from(r)
//     Ok(v)  => println("${v} ends at ${r.pos()}")   // -75 ends at 2
//     Err(e) => println(e.message())
// match varint.decode32_from(r)
//     Ok(v)  => println("${v} ends at ${r.pos()}")   // 300 ends at 4
//     Err(e) => println(e.message())
// ```
pub fn decode32_from(var src: Cursor) -> Result<Int, VarintError>
    let before = src.pos()
    match leb128.decode_from(src)
        Err(e)     => Err(lifted(e))
        Ok(folded) => narrowed(folded, src.pos() - before)

// Read the 32-bit varint at the start of `src`, ignoring what follows.
//
// The call reads the bytes where they are, as `decode` does.  A number
// that is well formed but too wide answers `NotInt32` rather than a
// truncation or a wrapped value, so the caller can read it again at 64
// bits.
//
// ```novo
// use std.bytes
//
// match varint.decode32(bytes.from_hex("9501") ?? bytes.zeros(0))
//     Ok(v)  => println("${v}")        // -75
//     Err(e) => println(e.message())
//
// // A valid 64-bit varint that no 32-bit reader can answer with.
// match varint.decode32(varint.encode(1 << 40))
//     Ok(v)  => println("${v}")
//     Err(e) => println(e.message())   // varint: … outside the signed 32-bit range
// ```
pub fn decode32(src: Bytes) -> Result<Int, VarintError>
    match read_folded_at(src, 0)
        Err(e) => Err(e)
        Ok(d)  => narrowed(d.value, d.len)

// Read the 32-bit varint at `off` in `src`, with the length it took.
//
// It is `decode_at` at the narrower width.  It walks the same way,
// answers the same `Decoded`, and answers `NotInt32` for a number this
// width cannot hold.  The error's count is the number's length, so a
// caller can skip the field it could not read.
//
// ```novo
// use std.bytes
//
// let buf = bytes.from_hex("9501") ?? bytes.zeros(0)
// match varint.decode32_at(buf, 0)
//     Ok(d)  => println("${d.value} in ${d.len} byte(s)")   // -75 in 2 byte(s)
//     Err(e) => println(e.message())
// ```
pub fn decode32_at(src: Bytes, off: Int) -> Result<Decoded, VarintError>
    match read_folded_at(src, off)
        Err(e) => Err(e)
        Ok(d)  =>
            match narrowed(d.value, d.len)
                Err(e) => Err(e)
                Ok(v)  => Ok(Decoded { value: v, len: d.len })

// ── The two pieces both widths share ─────────────────────────────────

// The folded value at `off` and the bytes it took, with the offset
// itself treated as input.  The two `decode_at` forms differ only in
// what they do with the folded number, so the walk lives here once.
//
// `leb128.decode_at` reads by offset and never builds a cursor.  A
// cursor may write into its buffer, and `src` is the caller's, handed
// over only to be read.  An offset outside the buffer is its
// `Truncated(after: 0)`.
fn read_folded_at(src: Bytes, off: Int) -> Result<Decoded, VarintError>
    match leb128.decode_at(src, off)
        Err(e) => Err(lifted(e))
        Ok(d)  => Ok(Decoded { value: d.value, len: d.len })

// A folded 64-bit value read as a 32-bit one.  The fold of a signed
// 32-bit number never reaches bit 32, so anything above `0xffffffff` is
// a number this width cannot hold.  That includes every folded value at
// or above 2^63, which arrives as a negative `Int`.
fn narrowed(folded: Int, used: Int) -> Result<Int, VarintError>
    if folded < 0 or folded > 0xffffffff
        Err(NotInt32(after: used))
    else
        Ok(zigzag.decode32(folded))
