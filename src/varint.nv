// Varint — a signed integer on a wire, in as few bytes as its
// magnitude needs.
//
// What it is.  LEB128 spends one byte per seven bits, so it is cheap
// for small numbers and expensive for large ones — and two's complement
// makes every negative number large, so a plain LEB128 of -1 is ten
// bytes.  ZigZag renumbers the integers first, 0, -1, 1, -2, 2, …, so
// that magnitude rather than sign decides the size.  Fold, then encode:
// that pairing is what Protocol Buffers calls `sint32` and `sint64`,
// and this module is the two halves as one call.
//
// What it does.  `encode` and `decode` at 64 bits and at 32, in an
// in-place form over a cursor and an allocating form that sizes its own
// buffer, plus `decode_at` for a caller walking a buffer by offset.
// `encoded_len` says how many bytes a value will take and `max_len` how
// many any value can take.  Each of those carries a worked example
// below.
//
// A malformed input is a value, never a panic: `VarintError` says the
// input ran out, the number does not fit 64 bits, or the number is
// outside the signed 32-bit range the 32-bit pair is defined over.
//
// What it costs.  The fold is two shifts and an xor, branch-free; the
// byte loop is one shift, one mask and one write per output byte.
// Neither allocates, and the arithmetic is `Int` throughout, so nothing
// here needs a heap.
//
// A word on the two widths.  The 64-bit pair covers the whole signed
// range and takes up to ten bytes.  The 32-bit pair is defined over the
// signed 32-bit range — `fits32` is the question to ask at the edge
// where the number arrives — and takes up to five, which is why a
// protocol that knows its numbers are 32-bit reaches for it.

use std.bytes
use leb128
use zigzag

// ── How much room a value needs ──────────────────────────────────────

// Answer the most bytes a 64-bit value can occupy: ten.
//
// The fold is a bijection onto the unsigned 64-bit range, so this is
// LEB128's own bound and not a looser one.  It is the room to reserve
// for a value you have not computed yet; `encoded_len` is the exact
// answer once you have.
pub fn max_len() -> Int
    leb128.max_len()

// Answer the most bytes a 32-bit value can occupy: five.
//
// The fold stays inside 32 bits, and five 7-bit groups carry 35 — one
// group more than enough.  Half the reservation of the 64-bit form,
// which is the reason a protocol that knows its numbers are 32-bit
// reaches for that pair.
pub fn max_len32() -> Int
    5

// Answer how many bytes `value` will occupy at 64 bits, without
// encoding it.
//
// Magnitude decides, not sign: `-1` and `1` are the same length, which
// is the whole point of folding first.  Nothing is refused and nothing
// is allocated.
//
// ```novo
// // Magnitude decides the length, not sign: a plain LEB128 would
// // spend ten bytes on each of the negatives here.
// println("${varint.encoded_len(0 - 1)} ${varint.encoded_len(1)}")         // 1 1
// println("${varint.encoded_len(0 - 1000)} ${varint.encoded_len(1000)}")   // 2 2
//
// // No value exceeds the reservation.
// println("${varint.encoded_len(1 << 62)} ${varint.max_len()}")      // 10 10
// ```
pub fn encoded_len(value: Int) -> Int
    leb128.encoded_len(zigzag.encode64(value))

// Answer how many bytes `value` will occupy at 32 bits, without
// encoding it.
//
// Defined over the signed 32-bit range — outside it the fold means
// something else, so ask `fits32` first.  Never more than `max_len32()`.
//
// ```novo
// println("${varint.encoded_len32(0 - 1)}")                              // 1
// println("${varint.encoded_len32(varint.min32())} ${varint.max_len32()}")   // 5 5
// ```
pub fn encoded_len32(value: Int) -> Int
    leb128.encoded_len(zigzag.encode32(value))

// ── The range the 32-bit pair is defined over ────────────────────────

// Answer the lowest value the 32-bit pair encodes exactly, `-2^31`.
//
// The bottom of Protocol Buffers' `sint32` range.  See `fits32`, which
// asks about both ends at once and carries the example.
pub fn min32() -> Int
    zigzag.min32()

// Answer the highest value the 32-bit pair encodes exactly, `2^31 - 1`.
//
// The top of the same range.  See `fits32`.
pub fn max32() -> Int
    zigzag.max32()

// Answer whether `n` is inside the range the 32-bit pair is defined
// over — the check a caller makes once, where the number arrives.
//
// `encode32` does not check and cannot usefully: it folds to a
// well-formed number that means something else to every other
// implementation, and nothing downstream would notice.  The 64-bit pair
// needs no such check, because every `Int` is in its range.
//
// ```novo
// println("${varint.fits32(varint.max32())}")       // true
// println("${varint.fits32(varint.max32() + 1)}")   // false
// println("${varint.fits32(varint.min32() - 1)}")   // false
// ```
pub fn fits32(n: Int) -> Bool
    zigzag.fits32(n)

// ── What can go wrong on the way in ──────────────────────────────────

// What went wrong while reading, and after how many bytes.
//
// All three are input faults rather than programming mistakes, so all
// three are values.  `Truncated` and `Overflow` come from the byte
// loop and can happen at either width; `NotInt32` is about the reader's
// width rather than the bytes, so a caller that gets it can re-read the
// same bytes at 64 bits and succeed.  `decode` and `decode32` carry the
// worked examples.
pub enum VarintError
    // The input ended while a continuation bit was still set.
    Truncated(after: Int)
    // The groups read so far already exceed 64 bits.
    Overflow(after: Int)
    // The number is well formed but outside the signed 32-bit range,
    // so a 32-bit reader cannot answer with it.
    NotInt32(after: Int)

// The standard `Error` implementation, so a bad varint can be reported
// by anything that reports errors.
impl Error for VarintError
    // Answer the one-line report: what was wrong, and after how many
    // bytes of input.  The count is in the text rather than left for
    // the caller to append, because the caller printing an error is the
    // one least likely to still have it to hand.
    fn message(self) -> Str
        match self
            Truncated(after) => "varint: input ended after ${after} byte(s) with the varint unfinished"
            Overflow(after)  => "varint: the varint exceeds 64 bits after ${after} byte(s)"
            NotInt32(after)  => "varint: the varint after ${after} byte(s) is outside the signed 32-bit range"

// A `Leb128Error` said in this module's vocabulary.  The byte loop is
// LEB128's, so its two faults are this module's two faults; the third
// is about the 32-bit range and only the 32-bit readers can raise it.
fn lifted(e: Leb128Error) -> VarintError
    match e
        Truncated(after) => VarintError.Truncated(after: after)
        Overflow(after)  => VarintError.Overflow(after: after)

// ── 64 bits ──────────────────────────────────────────────────────────

// Write `value` at the cursor in as many bytes as it needs, and answer
// that count.  Writes into the caller's buffer and allocates nothing.
//
// The cursor must have `encoded_len(value)` bytes of room — reserving
// `max_len()` always suffices.  Too little room is a panic, exactly as
// it is for `c.put_u8` and for `xs[i]`: a buffer the caller sized wrong
// is a mistake in the program, not a value the program should carry.
//
// ```novo
// use std.bytes
//
// // Two signed fields into one frame, back to back.
// var out = bytes.cursor_le(bytes.zeros(2 * varint.max_len()))
// let n = varint.encode_into(out, 0 - 1) + varint.encode_into(out, 300)
// println("${n}")                                         // 3
// println(bytes.to_hex(bytes.slice(out.finish(), 0, n)))  // 01d804
// ```
pub fn encode_into(mut dst: Cursor, value: Int) -> Int
    leb128.encode_into(dst, zigzag.encode64(value))

// Encode `value` into a fresh buffer of exactly its own length.
//
// One allocation, for the caller that is building a message rather than
// filling a frame.  `decode` inverts it exactly over the whole signed
// 64-bit range, which is the round trip worth relying on.
//
// ```novo
// use std.bytes
//
// // -1 is one byte here, and ten in a plain LEB128.
// println(bytes.to_hex(varint.encode(0 - 1)))    // 01
// println(bytes.to_hex(varint.encode(0 - 75)))   // 9501
//
// // The round trip, in the direction a caller depends on.
// match varint.decode(varint.encode(0 - 75))
//     Ok(v)  => println("${v}")                  // -75
//     Err(e) => println(e.message())
// ```
pub fn encode(value: Int) -> Bytes
    leb128.encode(zigzag.encode64(value))

// Read the varint at the cursor, leaving the cursor on the byte after
// it.  Reads out of the caller's buffer and allocates nothing.
//
// The cursor's position after a successful read is how far the number
// reached, so a caller decoding a run of varints needs nothing else —
// it calls again.
//
// ```novo
// use std.bytes
//
// // The two fields `encode_into`'s example wrote: -1, then 300.
// var r = bytes.cursor_le(bytes.from_hex("01d804") ?? bytes.zeros(0))
// match varint.decode_from(r)
//     Ok(v)  => println("${v} ends at ${r.pos()}")   // -1 ends at 1
//     Err(e) => println(e.message())
// match varint.decode_from(r)
//     Ok(v)  => println("${v} ends at ${r.pos()}")   // 300 ends at 3
//     Err(e) => println(e.message())
// ```
pub fn decode_from(mut src: Cursor) -> Result<Int, VarintError>
    match leb128.decode_from(src)
        Ok(folded) => Ok(zigzag.decode64(folded))
        Err(e)     => Err(lifted(e))

// Read the varint at the start of `src`, ignoring whatever follows it.
//
// The convenience form: it builds a cursor and throws it away, so a
// caller reading a run of varints should hold one cursor and call
// `decode_from` instead.  Malformed input is an `Err` carrying the byte
// count reached, never a panic.
//
// ```novo
// use std.bytes
//
// match varint.decode(bytes.from_hex("9501") ?? bytes.zeros(0))
//     Ok(v)  => println("${v}")          // -75
//     Err(e) => println(e.message())
//
// // A continuation bit with nothing after it: an answer, not a crash.
// match varint.decode(bytes.from_hex("95") ?? bytes.zeros(0))
//     Ok(v)  => println("${v}")
//     Err(e) => println(e.message())     // varint: input ended after 1 byte(s) …
// ```
pub fn decode(src: Bytes) -> Result<Int, VarintError>
    var c = bytes.cursor_le(src)
    decode_from(c)

// A varint and the number of bytes it occupied.
//
// The pair is one value rather than two returns because a reader that
// has the value and not the length cannot find the next field.
// `decode_at` and `decode32_at` are what answer one.
pub struct Decoded
    value: Int
    len: Int

// Read the varint at `off` in `src`, and answer it with the length it
// took.
//
// For a caller walking a buffer by offset rather than by cursor — a
// table of varint-encoded entries, a format that gives each record's
// start.  The next offset is `off + d.len`.
//
// An offset outside the buffer is `Truncated` rather than a panic: an
// offset read out of the data being decoded is input, and input is
// never a reason to crash.
//
// ```novo
// use std.bytes
//
// // -1 then 300; the second starts where the first one ended.
// let buf = bytes.from_hex("01d804") ?? bytes.zeros(0)
// match varint.decode_at(buf, 0)
//     Ok(d)  => println("${d.value} in ${d.len} byte(s)")   // -1 in 1 byte(s)
//     Err(e) => println(e.message())
// match varint.decode_at(buf, 1)
//     Ok(d)  => println("${d.value} in ${d.len} byte(s)")   // 300 in 2 byte(s)
//     Err(e) => println(e.message())
// ```
pub fn decode_at(src: Bytes, off: Int) -> Result<Decoded, VarintError>
    match read_folded_at(src, off)
        Err(e) => Err(e)
        Ok(d)  => Ok(Decoded { value: zigzag.decode64(d.value), len: d.len })

// ── 32 bits ──────────────────────────────────────────────────────────

// Write `value` at the cursor folded onto 32 bits, and answer the byte
// count.
//
// Defined over `fits32`: a value outside that range folds to a
// different number than every other implementation would produce, so
// the check belongs at the edge where the number arrives rather than
// here.  Reserving `max_len32()` always suffices.
//
// ```novo
// use std.bytes
//
// var out = bytes.cursor_le(bytes.zeros(varint.max_len32()))
// let n = varint.encode32_into(out, 0 - 75)
// println("${n}")                                         // 2
// println(bytes.to_hex(bytes.slice(out.finish(), 0, n)))  // 9501
// ```
pub fn encode32_into(mut dst: Cursor, value: Int) -> Int
    leb128.encode_into(dst, zigzag.encode32(value))

// Encode `value` folded onto 32 bits, as a fresh buffer of its own
// length.
//
// The same bytes as the 64-bit form everywhere both are defined — the
// fold is one renumbering, and the 32-bit half just has less room above
// it.  What differs is the ceiling: five bytes rather than ten.
//
// ```novo
// use std.bytes
//
// // Inside the 32-bit range the two widths agree byte for byte.
// println(bytes.to_hex(varint.encode32(0 - 75)))   // 9501
//
// match varint.decode32(varint.encode32(varint.min32()))
//     Ok(v)  => println("${v}")                    // -2147483648
//     Err(e) => println(e.message())
// ```
pub fn encode32(value: Int) -> Bytes
    leb128.encode(zigzag.encode32(value))

// Read the 32-bit varint at the cursor, leaving the cursor after it.
//
// A well-formed number outside the signed 32-bit range is `NotInt32`:
// the bytes are a valid varint, so the fault is the reader's width
// rather than the encoding, and saying which one it is lets a caller
// re-read the same bytes at 64 bits.  The cursor is left after the
// number either way, so that re-read starts from the right place.
pub fn decode32_from(mut src: Cursor) -> Result<Int, VarintError>
    let before = src.pos()
    match leb128.decode_from(src)
        Err(e)     => Err(lifted(e))
        Ok(folded) => narrowed(folded, src.pos() - before)

// Read the 32-bit varint at the start of `src`, ignoring what follows.
//
// The convenience form of `decode32_from`.  A number that is well
// formed but too wide is `NotInt32` rather than a truncation or a
// wrapped value — the reader says which of the two things went wrong,
// so the caller can decide to widen instead of guessing.
//
// ```novo
// use std.bytes
//
// match varint.decode32(bytes.from_hex("9501") ?? bytes.zeros(0))
//     Ok(v)  => println("${v}")        // -75
//     Err(e) => println(e.message())
//
// // A valid 64-bit varint that no 32-bit reader can answer with.
// match varint.decode32(varint.encode(1 << 40))
//     Ok(v)  => println("${v}")
//     Err(e) => println(e.message())   // varint: … outside the signed 32-bit range
// ```
pub fn decode32(src: Bytes) -> Result<Int, VarintError>
    var c = bytes.cursor_le(src)
    decode32_from(c)

// Read the 32-bit varint at `off` in `src`, with the length it took.
//
// `decode_at` asked at the narrower width: same walk, same `Decoded`,
// and `NotInt32` for a number this width cannot answer with.  The
// length is filled in even then, so a caller can skip the field it
// could not read.
pub fn decode32_at(src: Bytes, off: Int) -> Result<Decoded, VarintError>
    match read_folded_at(src, off)
        Err(e) => Err(e)
        Ok(d)  =>
            match narrowed(d.value, d.len)
                Err(e) => Err(e)
                Ok(v)  => Ok(Decoded { value: v, len: d.len })

// ── The two pieces both widths share ─────────────────────────────────

// The FOLDED value at `off` and the bytes it took, with the offset
// itself treated as input.  Both `decode_at` forms differ only in what
// they do with the folded number, so the walk lives here once.
//
// `leb128.decode_at` answers the same question, and is deliberately not
// used: it arrived in a later release than this package's requirement
// admits, and a package must call only what the range it publishes
// promises.
fn read_folded_at(src: Bytes, off: Int) -> Result<Decoded, VarintError>
    if off < 0 or off > bytes.len(src)
        Err(Truncated(after: 0))
    else
        var c = bytes.cursor_le(src)
        c.seek(off)
        match leb128.decode_from(c)
            Err(e)     => Err(lifted(e))
            Ok(folded) => Ok(Decoded { value: folded, len: c.pos() - off })

// A folded 64-bit value read as a 32-bit one.  The fold of a signed
// 32-bit number never reaches bit 32, so anything above `0xffffffff` —
// which includes every folded value at or above 2^63, carried as a
// negative `Int` — is a number this width cannot answer with.
fn narrowed(folded: Int, used: Int) -> Result<Int, VarintError>
    if folded < 0 or folded > 0xffffffff
        Err(NotInt32(after: used))
    else
        Ok(zigzag.decode32(folded))
